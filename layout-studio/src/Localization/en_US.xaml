<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="LOCLS_Search">Search settings (name or constant)</sys:String>
    <sys:String x:Key="LOCLS_Undo">Undo</sys:String>
    <sys:String x:Key="LOCLS_Redo">Redo</sys:String>
    <sys:String x:Key="LOCLS_ResetPage">Reset this page</sys:String>
    <sys:String x:Key="LOCLS_NeedsRestart">Some choices (button style, top panel) apply after you restart Playnite</sys:String>
    <sys:String x:Key="LOCLS_SectionsHint">Drag a section to reorder it or to move it to the other column (Genres, Categories, Features and Tags can switch column). The eye hides a section; the arrow sets whether it starts open.</sys:String>
    <sys:String x:Key="LOCLS_LeftColumn">Left column</sys:String>
    <sys:String x:Key="LOCLS_RightColumn">Right column</sys:String>
    <sys:String x:Key="LOCLS_OpenByDefault">Open by default</sys:String>
