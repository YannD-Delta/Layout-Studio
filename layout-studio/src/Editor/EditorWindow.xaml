<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ls="clr-namespace:LayoutStudio.Editor;assembly=LayoutStudio"
        Title="Layout Studio" Width="1080" Height="900" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="#FF14171C" Foreground="#FFE8EAED" FontSize="13">
    <Window.Resources>
        <ls:ColorTextToBrushConverter x:Key="ColorBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <ls:KindTemplateSelector x:Key="KindSelector" />
        <ls:PageContentSelector x:Key="PageSelector" />
        <ls:PathToImageConverter x:Key="PathToImage" />
        <ls:ChoiceCropConverter x:Key="ChoiceCrop" />
        <ls:GlyphTemplateSelector x:Key="GlyphSelector" />
        <ls:SceneTemplateSelector x:Key="SceneSelector" />

        <!-- A list entry that shows a picture of the choice when the mouse rests on it -->
        <DataTemplate x:Key="ChoiceWithPreview">
            <TextBlock Text="{Binding Name}" ToolTipService.InitialShowDelay="120" ToolTipService.Placement="Right" ToolTipService.IsEnabled="{Binding HasPreview}">
                <TextBlock.ToolTip>
                    <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Padding="4" Background="#FF1D2128" BorderBrush="#44FFFFFF">
                        <Image Source="{Binding PreviewPath, Converter={StaticResource PathToImage}}" MaxWidth="380" MaxHeight="240" Stretch="Uniform" />
                    </ToolTip>
                </TextBlock.ToolTip>
            </TextBlock>
        </DataTemplate>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="Margin" Value="0,18,0,6" />
        </Style>
        <Style x:Key="RestartBadge" TargetType="TextBlock">
            <Setter Property="Text" Value="&#8635;" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Foreground" Value="#FFFFB347" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="{DynamicResource LOCLS_NeedsRestartShort}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding NeedsRestart}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Arrow.Button" TargetType="RepeatButton">
            <Setter Property="Foreground" Value="#FFE8EAED" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="Face" Background="#FF2A3038" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#FF3A424D" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="#66FFB347" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFF7B72" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- Back to the default value: only visible on a modified setting, but it keeps its width so values do not jump -->
        <Style x:Key="Row.reset" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="Content" Value="&#xE777;" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="{Binding ResetTooltip}" />
            <Setter Property="Visibility" Value="Hidden" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsModified}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A row of the generated pages: orange dot when modified, title, restart badge, error, details tooltip -->
        <DataTemplate x:Key="Row.label">
            <StackPanel VerticalAlignment="Center" Background="Transparent" ToolTipService.InitialShowDelay="400">
                <StackPanel.ToolTip>
                    <ToolTip Padding="8,6" Background="#FF1D2128" BorderBrush="#44FFFFFF" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <StackPanel MaxWidth="420">
                            <!-- hovering a setting that has a schematic shows it larger -->
                            <ContentControl Content="{Binding}" ContentTemplateSelector="{StaticResource GlyphSelector}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <ContentControl.LayoutTransform><ScaleTransform ScaleX="1.8" ScaleY="1.8" /></ContentControl.LayoutTransform>
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasGlyph}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                                </ContentControl.Style>
                            </ContentControl>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="#FFA0A7B1">
                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Description}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Margin="0,5,0,0" FontSize="11" Foreground="#FF8A93A0" />
                        </StackPanel>
                    </ToolTip>
                </StackPanel.ToolTip>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="#FFFFB347" Margin="0,0,7,0" VerticalAlignment="Center">
                        <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Opacity" Value="0" /><Style.Triggers><DataTrigger Binding="{Binding IsModified}" Value="True"><Setter Property="Opacity" Value="1" /></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource RestartBadge}" />
                </StackPanel>
                <TextBlock Text="{Binding Error}" Margin="13,1,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource ErrorText}"><Style.Triggers><DataTrigger Binding="{Binding Error}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <!-- One template per control kind; KindTemplateSelector picks "Template.<kind>". -->
        <DataTemplate x:Key="Template.toggle">
            <DockPanel LastChildFill="False" Margin="0,5">
                <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource Row.label}" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Style="{StaticResource Row.reset}" Command="{Binding ResetCommand}" />
                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding BoolValue, Mode=TwoWay}" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>

        <!-- Small schematics next to a slider: a card with a picture, and the effect the setting controls drawn from its current value.
             Fraction is where the slider sits (0 to 1), FractionInverse its opposite, GlyphTopMargin pushes a marker down the 44 px picture. -->
        <ControlTemplate x:Key="GlyphFrame" TargetType="ContentControl">
            <Border Width="72" Height="44" CornerRadius="6" ClipToBounds="True" BorderBrush="#33FFFFFF" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF6F9BC8" Offset="0" />
                        <GradientStop Color="#FF2E4A6E" Offset="0.55" />
                        <GradientStop Color="#FF1B2433" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Path Data="M0,30 L18,16 L32,26 L50,10 L72,28 L72,44 L0,44 Z" Fill="#66101C2C" />
                    <ContentPresenter />
                </Grid>
            </Border>
        </ControlTemplate>

        <DataTemplate x:Key="Glyph.outline">
            <ContentControl Template="{StaticResource GlyphFrame}">
                <Border BorderBrush="White" BorderThickness="2" CornerRadius="5" Opacity="{Binding Fraction}" />
            </ContentControl>
        </DataTemplate>

        <DataTemplate x:Key="Glyph.blur-strong">
            <ContentControl Template="{StaticResource GlyphFrame}">
                <Grid>
                    <Path Stroke="White" StrokeThickness="2" Data="M8,22 V44 M18,22 V44 M28,22 V44 M38,22 V44 M48,22 V44 M58,22 V44 M67,22 V44" Opacity="{Binding FractionInverse}" />
                    <Path Stroke="White" StrokeThickness="2" Data="M8,22 V44 M18,22 V44 M28,22 V44 M38,22 V44 M48,22 V44 M58,22 V44 M67,22 V44" Opacity="{Binding Fraction}"><Path.Effect><BlurEffect Radius="9" /></Path.Effect></Path>
                </Grid>
            </ContentControl>
        </DataTemplate>

        <DataTemplate x:Key="Glyph.blur-light">
            <ContentControl Template="{StaticResource GlyphFrame}">
                <Grid>
                    <Path Stroke="White" StrokeThickness="2" Data="M8,22 V44 M18,22 V44 M28,22 V44 M38,22 V44 M48,22 V44 M58,22 V44 M67,22 V44" Opacity="{Binding FractionInverse}" />
                    <Path Stroke="White" StrokeThickness="2" Data="M8,22 V44 M18,22 V44 M28,22 V44 M38,22 V44 M48,22 V44 M58,22 V44 M67,22 V44" Opacity="{Binding Fraction}"><Path.Effect><BlurEffect Radius="3" /></Path.Effect></Path>
                </Grid>
            </ContentControl>
        </DataTemplate>

        <DataTemplate x:Key="Glyph.blur-opacity">
            <ContentControl Template="{StaticResource GlyphFrame}">
                <Grid>
                    <Path Stroke="White" StrokeThickness="2" Data="M8,22 V44 M18,22 V44 M28,22 V44 M38,22 V44 M48,22 V44 M58,22 V44 M67,22 V44" />
                    <Rectangle Margin="0,22,0,0" Fill="#FF2A3C58" Opacity="{Binding Fraction}" />
                    <Path Stroke="White" StrokeThickness="2" Data="M8,22 V44 M18,22 V44 M28,22 V44 M38,22 V44 M48,22 V44 M58,22 V44 M67,22 V44" Opacity="{Binding Fraction}"><Path.Effect><BlurEffect Radius="6" /></Path.Effect></Path>
                </Grid>
            </ContentControl>
        </DataTemplate>

        <!-- where something starts or ends along the height of the card: a line at that height, the blurred part below it -->
        <DataTemplate x:Key="Glyph.blur-start">
            <ContentControl Template="{StaticResource GlyphFrame}">
                <Grid Margin="{Binding GlyphTopMargin}">
                    <Rectangle Fill="#44FFFFFF" />
                    <Rectangle Height="2" VerticalAlignment="Top" Fill="#FFFFB347" />
                </Grid>
            </ContentControl>
        </DataTemplate>

        <DataTemplate x:Key="Glyph.blur-mid">
            <ContentControl Template="{StaticResource GlyphFrame}">
                <Grid Margin="{Binding GlyphTopMargin}">
                    <Rectangle Fill="#66FFFFFF" />
                    <Rectangle Height="2" VerticalAlignment="Top" Fill="#FFFFB347" />
                </Grid>
            </ContentControl>
        </DataTemplate>

        <DataTemplate x:Key="Glyph.blur-full">
            <ContentControl Template="{StaticResource GlyphFrame}">
                <Grid>
                    <Rectangle Fill="#44FFFFFF" Margin="0,18,0,0" />
                    <Grid Margin="{Binding GlyphTopMargin}"><Rectangle Fill="#99FFFFFF" /><Rectangle Height="2" VerticalAlignment="Top" Fill="#FFFFB347" /></Grid>
                </Grid>
            </ContentControl>
        </DataTemplate>

        <DataTemplate x:Key="Glyph.tint-accent">
            <ContentControl Template="{StaticResource GlyphFrame}">
                <Rectangle Margin="0,20,0,0" Fill="#FF3D9BFF" Opacity="{Binding Fraction}" />
            </ContentControl>
        </DataTemplate>

        <DataTemplate x:Key="Glyph.frost">
            <ContentControl Template="{StaticResource GlyphFrame}">
                <Rectangle Margin="0,20,0,0" Fill="White" Opacity="{Binding Fraction}" />
            </ContentControl>
        </DataTemplate>

        <!-- the picture fades into the page from the marker down; at the end of the slider it never fades -->
        <DataTemplate x:Key="Glyph.fade">
            <ContentControl Template="{StaticResource GlyphFrame}">
                <Rectangle Margin="{Binding GlyphTopMargin}">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#0014171C" Offset="0" />
                            <GradientStop Color="#FF14171C" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </ContentControl>
        </DataTemplate>

        <!-- an opacity: a veil over the picture, as strong as the slider says -->
        <DataTemplate x:Key="Glyph.opacity">
            <ContentControl Template="{StaticResource GlyphFrame}">
                <Border Margin="10,8" CornerRadius="5" Background="White" Opacity="{Binding Fraction}" />
            </ContentControl>
        </DataTemplate>

        <!-- a font size: a sample of text at that size -->
        <DataTemplate x:Key="Glyph.text-size">
            <ContentControl Template="{StaticResource GlyphFrame}">
                <TextBlock Text="Aa" FontSize="{Binding SliderValue}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </ContentControl>
        </DataTemplate>

        <DataTemplate x:Key="Template.slider">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="140" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <!-- a schematic of the effect, for the settings that have one (the artwork card look) -->
                <ContentControl Content="{Binding}" ContentTemplateSelector="{StaticResource GlyphSelector}" Margin="0,0,12,0" VerticalAlignment="Center">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasGlyph}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                    </ContentControl.Style>
                </ContentControl>
                <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource Row.label}" VerticalAlignment="Center" />
                <Slider Grid.Column="2" Minimum="{Binding Min}" Maximum="{Binding SliderMax}" SmallChange="{Binding Step}"
                        Value="{Binding SliderValue, Mode=TwoWay}" IsSnapToTickEnabled="False" VerticalAlignment="Center" Margin="8,0" />
                <TextBox Grid.Column="3" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Right" />
                <Button Grid.Column="4" Style="{StaticResource Row.reset}" Command="{Binding ResetCommand}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Template.number">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="140" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Row.label}" VerticalAlignment="Center" />
                <DockPanel Grid.Column="1">
                    <StackPanel DockPanel.Dock="Right" Margin="4,0,0,0" VerticalAlignment="Stretch">
                        <RepeatButton Style="{StaticResource Arrow.Button}" Command="{Binding StepUpCommand}" Width="22" Height="15" Padding="0" ToolTip="Increase" Focusable="False">
                            <Path Data="M 0 4 L 4 0 L 8 4 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </RepeatButton>
                        <RepeatButton Style="{StaticResource Arrow.Button}" Command="{Binding StepDownCommand}" Width="22" Height="15" Padding="0" Margin="0,1,0,0" ToolTip="Decrease" Focusable="False">
                            <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </RepeatButton>
                    </StackPanel>
                    <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" />
                </DockPanel>
                <Button Grid.Column="2" Style="{StaticResource Row.reset}" Command="{Binding ResetCommand}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Template.text">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="140" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Row.label}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                <Button Grid.Column="2" Style="{StaticResource Row.reset}" Command="{Binding ResetCommand}" />
            </Grid>
        </DataTemplate>

        <!-- Margins and paddings: four boxes around a small picture of a box in its frame; the box moves as the numbers change, and the side being typed lights up -->
        <Style x:Key="SideBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="54" />
            <Setter Property="Tag" Value="side" />
            <Setter Property="ToolTip" Value="{DynamicResource LOCLS_SideBoxTip}" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SideCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SideLight" TargetType="Rectangle">
            <Setter Property="Fill" Value="#FFFFB347" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <DataTemplate x:Key="Template.sides">
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Row.label}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- the picture: a box in its frame; its margins follow the four numbers, and the side being typed lights up -->
                    <Border Width="84" Height="48" Margin="0,0,12,0" BorderBrush="#66FFFFFF" BorderThickness="1" Background="#14FFFFFF" CornerRadius="4" VerticalAlignment="Bottom">
                        <Grid>
                            <Border Margin="{Binding SidesPreview}" Background="#553D9BFF" BorderBrush="#FF3D9BFF" BorderThickness="1" CornerRadius="2" />
                            <Rectangle Width="3" HorizontalAlignment="Left" Margin="-2,0,0,0"><Rectangle.Style><Style TargetType="Rectangle" BasedOn="{StaticResource SideLight}"><Style.Triggers><DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=BoxLeft}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Rectangle.Style></Rectangle>
                            <Rectangle Width="3" HorizontalAlignment="Right" Margin="0,0,-2,0"><Rectangle.Style><Style TargetType="Rectangle" BasedOn="{StaticResource SideLight}"><Style.Triggers><DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=BoxRight}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Rectangle.Style></Rectangle>
                            <Rectangle Height="3" VerticalAlignment="Top" Margin="0,-2,0,0"><Rectangle.Style><Style TargetType="Rectangle" BasedOn="{StaticResource SideLight}"><Style.Triggers><DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=BoxTop}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Rectangle.Style></Rectangle>
                            <Rectangle Height="3" VerticalAlignment="Bottom" Margin="0,0,0,-2"><Rectangle.Style><Style TargetType="Rectangle" BasedOn="{StaticResource SideLight}"><Style.Triggers><DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=BoxBottom}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Rectangle.Style></Rectangle>
                        </Grid>
                    </Border>
                    <StackPanel Margin="0,0,5,0"><TextBlock Style="{StaticResource SideCaption}" Text="{Binding Side1Label}" /><TextBox x:Name="BoxLeft" Style="{StaticResource SideBox}" Text="{Binding Side1Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                    <StackPanel Margin="0,0,5,0"><TextBlock Style="{StaticResource SideCaption}" Text="{Binding Side2Label}" /><TextBox x:Name="BoxTop" Style="{StaticResource SideBox}" Text="{Binding Side2Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                    <StackPanel Margin="0,0,5,0"><TextBlock Style="{StaticResource SideCaption}" Text="{Binding Side3Label}" /><TextBox x:Name="BoxRight" Style="{StaticResource SideBox}" Text="{Binding Side3Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                    <StackPanel Margin="0,0,12,0"><TextBlock Style="{StaticResource SideCaption}" Text="{Binding Side4Label}" /><TextBox x:Name="BoxBottom" Style="{StaticResource SideBox}" Text="{Binding Side4Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                    <StackPanel><TextBlock Style="{StaticResource SideCaption}" Text="{Binding AllLabel}" /><TextBox Style="{StaticResource SideBox}" Text="{Binding AllText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource Row.reset}" Command="{Binding ResetCommand}" VerticalAlignment="Bottom" />
            </Grid>
        </DataTemplate>

        <!-- Corner radii: a rounded picture and one box per corner, clockwise from the top left -->
        <DataTemplate x:Key="Template.corners">
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Row.label}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Width="84" Height="48" Margin="0,0,12,0" BorderBrush="#FF3D9BFF" BorderThickness="1" Background="#553D9BFF" CornerRadius="{Binding CornersPreview}" VerticalAlignment="Bottom" />
                    <StackPanel Margin="0,0,5,0"><TextBlock Style="{StaticResource SideCaption}" Text="{Binding Side1Label}" /><TextBox Style="{StaticResource SideBox}" Text="{Binding Side1Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                    <StackPanel Margin="0,0,5,0"><TextBlock Style="{StaticResource SideCaption}" Text="{Binding Side2Label}" /><TextBox Style="{StaticResource SideBox}" Text="{Binding Side2Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                    <StackPanel Margin="0,0,5,0"><TextBlock Style="{StaticResource SideCaption}" Text="{Binding Side3Label}" /><TextBox Style="{StaticResource SideBox}" Text="{Binding Side3Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                    <StackPanel Margin="0,0,12,0"><TextBlock Style="{StaticResource SideCaption}" Text="{Binding Side4Label}" /><TextBox Style="{StaticResource SideBox}" Text="{Binding Side4Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                    <StackPanel><TextBlock Style="{StaticResource SideCaption}" Text="{Binding AllLabel}" /><TextBox Style="{StaticResource SideBox}" Text="{Binding AllText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource Row.reset}" Command="{Binding ResetCommand}" VerticalAlignment="Bottom" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Template.color">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="140" />
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Row.label}" VerticalAlignment="Center" />
                <ToggleButton Grid.Column="1" Width="26" Height="24" Padding="2" IsChecked="{Binding PickerOpen, Mode=TwoWay}" ToolTip="{DynamicResource LOCLS_Color_Pick}" x:Name="PickerToggle">
                    <Border Width="18" Height="16" CornerRadius="3" BorderBrush="#66FFFFFF" BorderThickness="1" Background="{Binding Text, Converter={StaticResource ColorBrush}}" />
                </ToggleButton>
                <Popup IsOpen="{Binding PickerOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=PickerToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="#FF1D2128" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4,0,8">
                        <StackPanel Width="236">
                            <WrapPanel Margin="0,0,0,8">
                                <Button Width="22" Height="22" Margin="2" Padding="0" Command="{Binding SetColorCommand}" CommandParameter="#FFFFFF" ToolTip="#FFFFFF"><Border Width="16" Height="16" CornerRadius="3" Background="#FFFFFF" /></Button>
                                    <Button Width="22" Height="22" Margin="2" Padding="0" Command="{Binding SetColorCommand}" CommandParameter="#E8EAED" ToolTip="#E8EAED"><Border Width="16" Height="16" CornerRadius="3" Background="#E8EAED" /></Button>
                                    <Button Width="22" Height="22" Margin="2" Padding="0" Command="{Binding SetColorCommand}" CommandParameter="#9AA3AE" ToolTip="#9AA3AE"><Border Width="16" Height="16" CornerRadius="3" Background="#9AA3AE" /></Button>
                                    <Button Width="22" Height="22" Margin="2" Padding="0" Command="{Binding SetColorCommand}" CommandParameter="#4A5260" ToolTip="#4A5260"><Border Width="16" Height="16" CornerRadius="3" Background="#4A5260" /></Button>
                                    <Button Width="22" Height="22" Margin="2" Padding="0" Command="{Binding SetColorCommand}" CommandParameter="#000000" ToolTip="#000000"><Border Width="16" Height="16" CornerRadius="3" Background="#000000" /></Button>
                                    <Button Width="22" Height="22" Margin="2" Padding="0" Command="{Binding SetColorCommand}" CommandParameter="#FF5252" ToolTip="#FF5252"><Border Width="16" Height="16" CornerRadius="3" Background="#FF5252" /></Button>
                                    <Button Width="22" Height="22" Margin="2" Padding="0" Command="{Binding SetColorCommand}" CommandParameter="#FF9800" ToolTip="#FF9800"><Border Width="16" Height="16" CornerRadius="3" Background="#FF9800" /></Button>
                                    <Button Width="22" Height="22" Margin="2" Padding="0" Command="{Binding SetColorCommand}" CommandParameter="#FFD54F" ToolTip="#FFD54F"><Border Width="16" Height="16" CornerRadius="3" Background="#FFD54F" /></Button>
                                    <Button Width="22" Height="22" Margin="2" Padding="0" Command="{Binding SetColorCommand}" CommandParameter="#4CAF50" ToolTip="#4CAF50"><Border Width="16" Height="16" CornerRadius="3" Background="#4CAF50" /></Button>
                                    <Button Width="22" Height="22" Margin="2" Padding="0" Command="{Binding SetColorCommand}" CommandParameter="#26C6DA" ToolTip="#26C6DA"><Border Width="16" Height="16" CornerRadius="3" Background="#26C6DA" /></Button>
                                    <Button Width="22" Height="22" Margin="2" Padding="0" Command="{Binding SetColorCommand}" CommandParameter="#1E90FF" ToolTip="#1E90FF"><Border Width="16" Height="16" CornerRadius="3" Background="#1E90FF" /></Button>
                                    <Button Width="22" Height="22" Margin="2" Padding="0" Command="{Binding SetColorCommand}" CommandParameter="#7C4DFF" ToolTip="#7C4DFF"><Border Width="16" Height="16" CornerRadius="3" Background="#7C4DFF" /></Button>
                                    <Button Width="22" Height="22" Margin="2" Padding="0" Command="{Binding SetColorCommand}" CommandParameter="#E040FB" ToolTip="#E040FB"><Border Width="16" Height="16" CornerRadius="3" Background="#E040FB" /></Button>
                                    <Button Width="22" Height="22" Margin="2" Padding="0" Command="{Binding SetColorCommand}" CommandParameter="#FF4081" ToolTip="#FF4081"><Border Width="16" Height="16" CornerRadius="3" Background="#FF4081" /></Button>
                                    <Button Width="22" Height="22" Margin="2" Padding="0" Command="{Binding SetColorCommand}" CommandParameter="#1A9FFF" ToolTip="#1A9FFF"><Border Width="16" Height="16" CornerRadius="3" Background="#1A9FFF" /></Button>
                                    <Button Width="22" Height="22" Margin="2" Padding="0" Command="{Binding SetColorCommand}" CommandParameter="#2BB943" ToolTip="#2BB943"><Border Width="16" Height="16" CornerRadius="3" Background="#2BB943" /></Button>
                            </WrapPanel>
                            <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Left" Text="A" Width="16" Opacity="0.7" VerticalAlignment="Center" /><TextBlock DockPanel.Dock="Right" Text="{Binding ColorA, StringFormat={}{0:0}}" Width="30" TextAlignment="Right" VerticalAlignment="Center" /><Slider Minimum="0" Maximum="255" SmallChange="1" LargeChange="16" Value="{Binding ColorA, Mode=TwoWay}" /></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Left" Text="R" Width="16" Foreground="#FFFF7B72" VerticalAlignment="Center" /><TextBlock DockPanel.Dock="Right" Text="{Binding ColorR, StringFormat={}{0:0}}" Width="30" TextAlignment="Right" VerticalAlignment="Center" /><Slider Minimum="0" Maximum="255" SmallChange="1" LargeChange="16" Value="{Binding ColorR, Mode=TwoWay}" /></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Left" Text="G" Width="16" Foreground="#FF6FD08C" VerticalAlignment="Center" /><TextBlock DockPanel.Dock="Right" Text="{Binding ColorG, StringFormat={}{0:0}}" Width="30" TextAlignment="Right" VerticalAlignment="Center" /><Slider Minimum="0" Maximum="255" SmallChange="1" LargeChange="16" Value="{Binding ColorG, Mode=TwoWay}" /></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Left" Text="B" Width="16" Foreground="#FF8AB4F8" VerticalAlignment="Center" /><TextBlock DockPanel.Dock="Right" Text="{Binding ColorB, StringFormat={}{0:0}}" Width="30" TextAlignment="Right" VerticalAlignment="Center" /><Slider Minimum="0" Maximum="255" SmallChange="1" LargeChange="16" Value="{Binding ColorB, Mode=TwoWay}" /></DockPanel>
                        </StackPanel>
                    </Border>
                </Popup>
                <TextBox Grid.Column="2" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="6,0,0,0" />
                <Button Grid.Column="3" Style="{StaticResource Row.reset}" Command="{Binding ResetCommand}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Template.choice">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="140" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Row.label}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" ItemTemplate="{StaticResource ChoiceWithPreview}" SelectedItem="{Binding SelectedChoice, Mode=TwoWay}" />
                <Button Grid.Column="2" Style="{StaticResource Row.reset}" Command="{Binding ResetCommand}" />
            </Grid>
        </DataTemplate>

        <!-- Picture tiles for presets and a segmented bar for short lists of choices: one click, the picture shows what it changes -->
        <Style x:Key="TileItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Face" CornerRadius="12" Background="#26FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1.5" Padding="6">
                            <ContentPresenter TextElement.Foreground="#FFE8EAED" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#3AFFFFFF" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="#FF3D9BFF" />
                                <Setter TargetName="Face" Property="Background" Value="#2E3D9BFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PillItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Face" CornerRadius="9" Background="#1FFFFFFF" Padding="14,5">
                            <TextBlock x:Name="Label" Text="{Binding Name}" Foreground="#FFE8EAED" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#33FFFFFF" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#FF3D9BFF" />
                                <Setter TargetName="Label" Property="Foreground" Value="#FF0B1118" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlainList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox"><ItemsPresenter /></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="Template.presetTiles">
            <StackPanel Margin="0,8,0,4">
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Row.reset}" Command="{Binding ResetCommand}" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Row.label}" />
                </DockPanel>
                <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice, Mode=TwoWay}" ItemContainerStyle="{StaticResource TileItem}">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="168">
                                <!-- only the part of the picture that differs between the choices of the group, enlarged; nothing when there is no difference to show -->
                                <Border CornerRadius="6" ClipToBounds="True" Background="#FF1A1F27" Margin="0,0,0,4">
                                    <Image Source="{Binding Converter={StaticResource ChoiceCrop}}" Stretch="Uniform" MaxHeight="64" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <TextBlock Text="{Binding Name}" Margin="2,2,2,0" FontSize="12" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" />
                                <!-- what the choice sets, folded: clicking the arrow does not pick the tile -->
                                <Expander Header="{Binding VariablesHeader}" FontSize="11" Margin="0,3,0,0" Foreground="#FFA0A7B1">
                                    <Expander.Style>
                                        <Style TargetType="Expander"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasVariables}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                                    </Expander.Style>
                                    <ItemsControl ItemsSource="{Binding Variables}" Margin="4,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,1">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Margin="6,0,0,0" Foreground="#FFFFC56E" FontSize="10.5" />
                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontSize="10.5" Foreground="#FFC4CAD2" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Template.segmented">
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Row.label}" VerticalAlignment="Center" />
                <Border Grid.Column="1" CornerRadius="11" Background="#14FFFFFF" Padding="3">
                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice, Mode=TwoWay}" ItemContainerStyle="{StaticResource PillItem}">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    </ListBox>
                </Border>
                <Button Grid.Column="2" Style="{StaticResource Row.reset}" Command="{Binding ResetCommand}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Template.orderedList">
            <StackPanel Margin="0,5">
                <TextBlock Text="{Binding Title}" Margin="0,0,0,4" />
                <ListBox ItemsSource="{Binding Items}" BorderThickness="0" Background="#22FFFFFF" MaxWidth="560" HorizontalAlignment="Left">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2,1" LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="&#9660;" Width="28" Margin="2,0,0,0"
                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                <Button DockPanel.Dock="Right" Content="&#9650;" Width="28"
                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Template.tileSlots">
            <StackPanel Margin="0,5">
                <TextBlock Text="{Binding Title}" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding Slots}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2" MaxWidth="560" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="300" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Index, StringFormat=Tile {0}}" VerticalAlignment="Center" Opacity="0.7" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" ItemTemplate="{StaticResource ChoiceWithPreview}" SelectedItem="{Binding SelectedChoice, Mode=TwoWay}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Template.unsupported">
            <TextBlock Margin="0,5" Opacity="0.5">
                <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="  (editor for this setting type: coming next)" />
            </TextBlock>
        </DataTemplate>

        <DataTemplate x:Key="Page.settings">
            <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource LOCLS_NoSettingMatches}" Opacity="0.6" Margin="0,4,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Dimmed}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                </TextBlock.Style>
            </TextBlock>
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Chips}" Margin="0,0,14,8">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasChips}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding SelectCommand}" Padding="12,4" Margin="0,0,6,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#55FFB347" /><Setter Property="Foreground" Value="#FFFFC56E" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" />
                                <TextBlock Text="{Binding Count}" Opacity="0.55" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,14,14" Padding="0,0,14,0">
                <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{DynamicResource GroupTemplate}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Visible}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </ScrollViewer>
            </DockPanel>
        </DataTemplate>

        <!-- A section block: drag it, or press its left/right button to send it to the other column (disabled when the section is fixed in its column) -->
        <DataTemplate x:Key="Block.section">
            <Grid>
            <Border x:Name="Block" Margin="0,0,0,6" Padding="10,8" CornerRadius="8" Background="#2AFFFFFF" Cursor="Hand"
                    ls:DragDropBehavior.DragKind="section">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Command="{Binding OptionsCommand}" FontFamily="Segoe MDL2 Assets" Content="&#xE712;" Width="28" Margin="4,0,0,0" Cursor="Arrow" ToolTip="{DynamicResource LOCLS_AllOptions}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding HasOptions}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding OpenByDefault, Mode=OneWay}" Command="{Binding ToggleOpenCommand}"
                                  FontFamily="Segoe MDL2 Assets" Content="&#xE70D;" Width="28" Margin="4,0,0,0" ToolTip="{DynamicResource LOCLS_OpenByDefault}" />
                    <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding Visible, Mode=OneWay}" Command="{Binding ToggleVisibleCommand}"
                                  FontFamily="Segoe MDL2 Assets" Content="&#xE7B3;" Width="28" Margin="4,0,0,0" ToolTip="{DynamicResource LOCLS_Visible}">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanHide}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Button DockPanel.Dock="Right" Command="{Binding MoveColumnCommand}" FontFamily="Segoe MDL2 Assets" Width="28" Margin="4,0,0,0" Cursor="Arrow"
                            Content="&#xE76C;" ToolTip="{DynamicResource LOCLS_MoveToRight}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Column}" Value="1">
                                        <Setter Property="Content" Value="&#xE76B;" />
                                        <Setter Property="ToolTip" Value="{DynamicResource LOCLS_MoveToLeft}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CanMove}" Value="False">
                                        <Setter Property="Opacity" Value="0.25" />
                                        <Setter Property="ToolTip" Value="{DynamicResource LOCLS_ColumnFixed}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Row.label}" VerticalAlignment="Center" />
                </DockPanel>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Visible}" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <!-- the insertion line while a section is dragged over this column: drawn over the gap above the block, so nothing moves -->
            <Border Height="3" CornerRadius="1.5" Background="#FFFFB347" VerticalAlignment="Top" Margin="0,-5,0,0" IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DropLineAbove}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            </Grid>
        </DataTemplate>

        <!-- A section column: the blocks, then the insertion line for a drop after the last one (Tag = whether that line shows) -->
        <ControlTemplate x:Key="SectionColumn" TargetType="ItemsControl">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}">
                <StackPanel>
                    <ItemsPresenter />
                    <Border Height="3" CornerRadius="1.5" Background="#FFFFB347" Margin="0,-3,0,0" IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
            </Border>
        </ControlTemplate>

        <DataTemplate x:Key="Page.sections">
            <Grid DataContext="{Binding Editor}" Margin="0,0,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource LOCLS_SectionsHint}" TextWrapping="Wrap" Opacity="0.65" Margin="0,0,0,10" />
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource LOCLS_LeftColumn}" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Left}" ItemTemplate="{StaticResource Block.section}" Template="{StaticResource SectionColumn}" Tag="{Binding LeftDropLineAtEnd}"
                                          Background="#11FFFFFF" MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Padding="8" ls:DragDropBehavior.DropColumn="0" />
                        </ScrollViewer>
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource LOCLS_RightColumn}" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Right}" ItemTemplate="{StaticResource Block.section}" Template="{StaticResource SectionColumn}" Tag="{Binding RightDropLineAtEnd}"
                                          Background="#11FFFFFF" MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Padding="8" ls:DragDropBehavior.DropColumn="1" />
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Grid>
        </DataTemplate>


        <!-- ===== Sizes page: handles by axis, ratio chips, locator, groups ===== -->

        <Style x:Key="Handle.Bar" TargetType="Thumb">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Background" Value="#FFFFB347" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FFFFC56E" /></Trigger>
                <Trigger Property="IsDragging" Value="True"><Setter Property="Background" Value="#FFFFC56E" /></Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="Size.locatorSmall">
            <Border Width="120" Height="60" CornerRadius="5" Background="#FF15181D" BorderBrush="#29FFFFFF" BorderThickness="1" ClipToBounds="True">
                <Viewbox Stretch="Fill">
                    <Canvas Width="200" Height="100">
                        <Rectangle Canvas.Left="0" Canvas.Top="0" Width="4" Height="100" Fill="#10FFFFFF" />
                        <Rectangle Canvas.Left="4" Canvas.Top="0" Width="196" Height="8.7" Fill="#14FFFFFF" />
                        <Rectangle Canvas.Left="8.4" Canvas.Top="9.4" Width="33" Height="90" Fill="#0CFFFFFF" />
                        <Rectangle Canvas.Left="41.6" Canvas.Top="10.4" Width="156" Height="40.8" Fill="#16FFFFFF" />
                        <Rectangle Canvas.Left="43.8" Canvas.Top="24.5" Width="23" Height="34.9" Fill="#22FFFFFF" />
                        <Rectangle Canvas.Left="68.6" Canvas.Top="53.9" Width="125" Height="5.5" Fill="#14FFFFFF" />
                        <Rectangle Canvas.Left="41.6" Canvas.Top="60.2" Width="156" Height="19.5" Fill="#0EFFFFFF" />
                        <Rectangle Canvas.Left="41.6" Canvas.Top="80.3" Width="76" Height="3" Fill="#12FFFFFF" />
                        <Rectangle Canvas.Left="122" Canvas.Top="80.3" Width="75" Height="3" Fill="#12FFFFFF" />
                        <!-- the zone -->
                        <Rectangle Canvas.Left="{Binding LocatorX}" Canvas.Top="{Binding LocatorY}" Width="{Binding LocatorWidth}" Height="{Binding LocatorHeight}"
                                   Fill="#4DFFB347" Stroke="#FFFFB347" StrokeThickness="1.2" />
                        <Ellipse Canvas.Left="{Binding LocatorBeaconX}" Canvas.Top="{Binding LocatorBeaconY}" Width="14" Height="14" Stroke="#80FFB347" StrokeThickness="1" Visibility="{Binding LocatorIsSmall, Converter={StaticResource BoolToVis}}" />
                    </Canvas>
                </Viewbox>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="Size.card">
            <Border Width="372" Margin="0,0,12,12" Padding="14,14" CornerRadius="10" BorderThickness="1" Cursor="Arrow">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FF1D2128" />
                        <Setter Property="BorderBrush" Value="#14FFFFFF" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FF20252C" /></Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="BorderBrush" Value="#66FFB347" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsVisible}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <!-- row 1: modified dot, title, badges, reset -->
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding ResetCommand}" Content="Reset" Padding="8,1" FontSize="11" ToolTip="Back to the default" />
                        <Border DockPanel.Dock="Right" Margin="0,0,8,0" Padding="7,1" CornerRadius="9" Background="#1A6FD08C" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LiveText}" FontSize="10.5" Foreground="#FF6FD08C" />
                        </Border>
                        <TextBlock Style="{StaticResource RestartBadge}" DockPanel.Dock="Right" />
                        <Ellipse Width="6" Height="6" Fill="#FFFFB347" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding IsModified}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#FFA0A7B1" TextWrapping="Wrap" Margin="0,4,0,10" />

                    <!-- row 3: locator and where -->
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Size.locatorSmall}" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Width="210">
                            <TextBlock Text="WHERE" FontSize="10.5" FontWeight="SemiBold" Foreground="#FF8A93A0" />
                            <TextBlock Text="{Binding WhereLabel}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,4" />
                            <Border HorizontalAlignment="Left" Padding="8,1" CornerRadius="9" Background="#FF252A32">
                                <TextBlock Text="{Binding ViewChip}" FontSize="10.5" Foreground="#FFA0A7B1" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- stage: the box, its maximum, the handles of its axes -->
                    <Border Margin="0,12,0,10" Padding="10,10,20,20" CornerRadius="8" Background="#FF15181D" BorderBrush="#14FFFFFF" BorderThickness="1" Height="{Binding StageHeight}">
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Rectangle Width="{Binding MaxOutlineWidth}" Height="{Binding MaxOutlineHeight}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Stroke="#33FFFFFF" StrokeThickness="1" StrokeDashArray="4 3" />
                            <Border Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Background="#26FFFFFF" BorderBrush="#99FFFFFF" BorderThickness="1.5" CornerRadius="3" />

                            <!-- right bar: the width -->
                            <Thumb Tag="resize-w" Width="14" Height="{Binding DisplayHeight}" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeWE" Style="{StaticResource Handle.Bar}"
                                   Margin="{Binding RightBarMargin}" AutomationProperties.Name="{Binding Title}">
                                <Thumb.Visibility><Binding Path="HasRightBar" Converter="{StaticResource BoolToVis}" /></Thumb.Visibility>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid Background="Transparent">
                                            <Border Width="4" Height="28" CornerRadius="2" Background="{TemplateBinding Background}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                            <!-- bottom bar: the height -->
                            <Thumb Tag="resize-h" Height="14" Width="{Binding DisplayWidth}" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNS" Style="{StaticResource Handle.Bar}"
                                   Margin="{Binding BottomBarMargin}" AutomationProperties.Name="{Binding Title}">
                                <Thumb.Visibility><Binding Path="HasBottomBar" Converter="{StaticResource BoolToVis}" /></Thumb.Visibility>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid Background="Transparent">
                                            <Border Width="28" Height="4" CornerRadius="2" Background="{TemplateBinding Background}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                            <!-- corner bracket: both axes (or the side of a square) -->
                            <Thumb Tag="resize-wh" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" Style="{StaticResource Handle.Bar}"
                                   Margin="{Binding CornerMargin}" AutomationProperties.Name="{Binding Title}">
                                <Thumb.Visibility><Binding Path="HasCorner" Converter="{StaticResource BoolToVis}" /></Thumb.Visibility>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid Background="Transparent">
                                            <Path Data="M 3 11 L 11 11 L 11 3" Stroke="{TemplateBinding Background}" StrokeThickness="3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                            <!-- value bubble while dragging -->
                            <Border Margin="{Binding BubbleMargin}" Padding="6,2" CornerRadius="4" Background="#FF0E1013" BorderBrush="#FFFFB347" BorderThickness="1"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsDragging}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding BubbleText}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- fields -->
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasWidth, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="W" VerticalAlignment="Center" Foreground="#FFA0A7B1" Margin="0,0,6,0" />
                            <TextBox Width="70" Text="{Binding WidthText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Right" />
                            <StackPanel Margin="3,0,0,0">
                                <RepeatButton Style="{StaticResource Arrow.Button}" Command="{Binding WidthUpCommand}" Width="20" Height="13" Padding="0" Focusable="False"><Path Data="M 0 3 L 3.5 0 L 7 3 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}" HorizontalAlignment="Center" VerticalAlignment="Center" /></RepeatButton>
                                <RepeatButton Style="{StaticResource Arrow.Button}" Command="{Binding WidthDownCommand}" Width="20" Height="13" Padding="0" Margin="0,1,0,0" Focusable="False"><Path Data="M 0 0 L 3.5 3 L 7 0 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}" HorizontalAlignment="Center" VerticalAlignment="Center" /></RepeatButton>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" Visibility="{Binding ShowHeightField, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="H" VerticalAlignment="Center" Foreground="#FFA0A7B1" Margin="0,0,6,0" />
                            <TextBox Width="70" Text="{Binding HeightText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Right" />
                            <StackPanel Margin="3,0,0,0">
                                <RepeatButton Style="{StaticResource Arrow.Button}" Command="{Binding HeightUpCommand}" Width="20" Height="13" Padding="0" Focusable="False"><Path Data="M 0 3 L 3.5 0 L 7 3 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}" HorizontalAlignment="Center" VerticalAlignment="Center" /></RepeatButton>
                                <RepeatButton Style="{StaticResource Arrow.Button}" Command="{Binding HeightDownCommand}" Width="20" Height="13" Padding="0" Margin="0,1,0,0" Focusable="False"><Path Data="M 0 0 L 3.5 3 L 7 0 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}" HorizontalAlignment="Center" VerticalAlignment="Center" /></RepeatButton>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding ScaleLabel}" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="10.5" Foreground="#FF8A93A0" ToolTip="Drawing scale" />
                    </StackPanel>
                    <TextBlock Text="{Binding RangeText}" FontSize="11" Foreground="#FF8A93A0" Margin="0,5,0,0" TextWrapping="Wrap" />

                    <!-- ratio chips and lock -->
                    <StackPanel Margin="0,8,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding HasRatio}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Command="{Binding ToggleLockCommand}" Padding="8,2" Margin="0,0,8,0" VerticalAlignment="Top" ToolTip="Keep the ratio while you resize (Alt = ignore for one drag)">
                                <TextBlock FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Ratio: free" />
                                            <Style.Triggers><DataTrigger Binding="{Binding IsRatioLocked}" Value="True"><Setter Property="Text" Value="Ratio: locked" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <ItemsControl ItemsSource="{Binding Ratios}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding SelectCommand}" Content="{Binding Label}" Padding="9,1" Margin="0,0,5,5" FontSize="11" ToolTip="{Binding DisabledReason}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#55FFB347" /><Setter Property="Foreground" Value="#FFFFC56E" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False"><Setter Property="Opacity" Value="0.35" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- The preview dock draws a non-live size in its context: "Scene.<size id>", or the plain box. Bindings are those of the size card. -->
        <DataTemplate x:Key="Scene.box">
            <Border Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}" Background="#448AB4F8" BorderBrush="#FF8AB4F8" BorderThickness="1.5" CornerRadius="4">
                <TextBlock Text="{Binding ScaleLabel}" FontSize="11" Foreground="#FFC4CAD2" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <!-- the Links section with three rows: the icon is the size being set -->
        <DataTemplate x:Key="Scene.linkIcon">
            <Border Width="240" Background="#FF1D2128" CornerRadius="8" Padding="12,8" BorderBrush="#22FFFFFF" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="LINKS" FontSize="11" FontWeight="SemiBold" Foreground="#FF8A93A0" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,3"><Border Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}" Background="#668AB4F8" BorderBrush="#FF8AB4F8" BorderThickness="1" CornerRadius="3" /><TextBlock Text="Official website" Margin="10,0,0,0" VerticalAlignment="Center" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3"><Border Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}" Background="#668AB4F8" BorderBrush="#FF8AB4F8" BorderThickness="1" CornerRadius="3" /><TextBlock Text="Wiki" Margin="10,0,0,0" VerticalAlignment="Center" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3"><Border Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}" Background="#668AB4F8" BorderBrush="#FF8AB4F8" BorderThickness="1" CornerRadius="3" /><TextBlock Text="Store page" Margin="10,0,0,0" VerticalAlignment="Center" /></StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- the description: a block of text lines as wide as the setting -->
        <DataTemplate x:Key="Scene.description">
            <Border Width="{Binding DisplayWidth}" Background="#FF1D2128" CornerRadius="6" Padding="10,8" BorderBrush="#FF8AB4F8" BorderThickness="1">
                <StackPanel>
                    <Rectangle Height="6" Fill="#55FFFFFF" Margin="0,0,0,6" RadiusX="3" RadiusY="3" />
                    <Rectangle Height="6" Fill="#55FFFFFF" Margin="0,0,14,6" RadiusX="3" RadiusY="3" />
                    <Rectangle Height="6" Fill="#55FFFFFF" Margin="0,0,0,6" RadiusX="3" RadiusY="3" />
                    <Rectangle Height="6" Fill="#55FFFFFF" Margin="0,0,40,0" RadiusX="3" RadiusY="3" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- the game logo on the banner: the box is the largest it may be -->
        <DataTemplate x:Key="Scene.gameLogo">
            <Border Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}" Background="#33000000" BorderBrush="#FF8AB4F8" BorderThickness="1.5" CornerRadius="4">
                <TextBlock Text="GAME LOGO" FontSize="13" FontWeight="Bold" Foreground="#FFE8EAED" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="Page.sizes">
            <DockPanel DataContext="{Binding Editor}">
                <!-- header: hint, filter, changed only -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,14,6">
                    <TextBlock Text="{DynamicResource LOCLS_SizesHint}" TextWrapping="Wrap" Foreground="#FFA0A7B1" Margin="0,0,0,8" />
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ChangedOnly, Mode=TwoWay}" Content="{DynamicResource LOCLS_ChangedOnly}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <TextBox Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" ToolTip="Filter by name, description or place" />
                    </DockPanel>
                </StackPanel>
                <!-- preview dock: a slim notice when the selected size is on screen; a drawing of its box when it is not (or when pinned) -->
                <Border DockPanel.Dock="Top" Margin="0,0,14,8" Padding="12,8" CornerRadius="10" Background="#FF1A1F27" BorderBrush="#338AB4F8" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DockState}" Value="Slim"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding DockState}" Value="Full"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding CloseDockCommand}" Content="&#xE894;" FontFamily="Segoe MDL2 Assets" Width="26" Height="24" Padding="0" Margin="8,0,0,0" VerticalAlignment="Top" ToolTip="Close the preview" />
                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding PinPreview, Mode=TwoWay}" Content="{DynamicResource LOCLS_PinPreview}" VerticalAlignment="Top" Margin="8,3,0,0" />
                        <!-- where the item sits in the window, lit on the same miniature as the card's -->
                        <ContentControl DockPanel.Dock="Left" Content="{Binding Active}" ContentTemplate="{StaticResource Size.locatorSmall}" Margin="0,0,14,0" VerticalAlignment="Top">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding DockState}" Value="Full"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                        <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,5,10,0" VerticalAlignment="Top">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#FF6FD08C" />
                                    <Style.Triggers><DataTrigger Binding="{Binding DockState}" Value="Full"><Setter Property="Fill" Value="#FF8AB4F8" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <StackPanel>
                            <TextBlock Text="{Binding DockText}" TextWrapping="Wrap" />
                            <!-- the box at the item's scale, with its numbers; it moves with the fields of the card -->
                            <Grid DataContext="{Binding Active}" Margin="0,8,0,0" HorizontalAlignment="Left">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding DataContext.DockState, RelativeSource={RelativeSource AncestorType=DockPanel}}" Value="Full"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Viewbox MaxWidth="300" MaxHeight="120" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                    <ContentControl Content="{Binding}" ContentTemplateSelector="{StaticResource SceneSelector}" />
                                </Viewbox>
                            </Grid>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,14,14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource LOCLS_NoSizeMatches}" Foreground="#FFA0A7B1" Margin="0,24,0,0" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Margin="0,8,0,8">
                                            <Run Text="{Binding Title, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" />
                                            <Run Text="{Binding VisibleCount, Mode=OneWay}" Foreground="#FF8A93A0" FontSize="12" />
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{DynamicResource Size.card}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </DataTemplate>

        <!-- First page: graphics and performance advice. A status dot, what the setting is, what it changes (with measured numbers), and a fix. -->
        <Style x:Key="ImpactChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="9,2" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <DataTemplate x:Key="Advice.item">
            <Border Margin="0,0,0,10" Padding="16,12" CornerRadius="12" BorderThickness="1.5" BorderBrush="#22FFFFFF">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FF1D2128" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusName}" Value="attention"><Setter Property="BorderBrush" Value="#99FFB347" /><Setter Property="Background" Value="#22FFB347" /></DataTrigger>
                            <DataTrigger Binding="{Binding StatusName}" Value="tip"><Setter Property="BorderBrush" Value="#553D9BFF" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Button Command="{Binding FixCommand}" Content="{Binding FixLabel}" Padding="14,5" Margin="0,0,0,6" MinWidth="96">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasFix}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                        <Button Command="{Binding OpenPageCommand}" Content="{Binding PageLabel}" Padding="14,5" MinWidth="96">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasPage}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Margin="0,0,10,0">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource ImpactChip}">
                                        <Setter Property="Background" Value="#334CD98B" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusName}" Value="attention"><Setter Property="Background" Value="#66FFB347" /></DataTrigger>
                                            <DataTrigger Binding="{Binding StatusName}" Value="tip"><Setter Property="Background" Value="#443D9BFF" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Style="{StaticResource ImpactChip}" Background="#40B388FF"><Border.Visibility><Binding Path="HasGraphics" Converter="{StaticResource BoolToVis}" /></Border.Visibility><TextBlock Text="{DynamicResource LOCLS_Adv_ChipGraphics}" FontSize="11" /></Border>
                            <Border Style="{StaticResource ImpactChip}" Background="#4035D0BA"><Border.Visibility><Binding Path="HasPerformance" Converter="{StaticResource BoolToVis}" /></Border.Visibility><TextBlock Text="{DynamicResource LOCLS_Adv_ChipPerformance}" FontSize="11" /></Border>
                        </StackPanel>
                        <TextBlock Text="{Binding What}" TextWrapping="Wrap" Foreground="#FFC9CED6" />
                        <TextBlock Text="{Binding Measured}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF8FB8E8" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="Page.advice">
            <ScrollViewer DataContext="{Binding Editor}" VerticalScrollBarVisibility="Auto" Margin="0,0,14,14">
                <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Summary}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock TextWrapping="Wrap" Foreground="#FFC9CED6" Margin="0,0,0,4"
                               Text="{DynamicResource LOCLS_Adv_Intro}" />
                    <TextBlock Text="{Binding MeasuredOn}" TextWrapping="Wrap" Opacity="0.55" FontSize="11" Margin="0,0,0,14" />
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource Advice.item}" />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- Items: a card per piece of information or section, with every option the theme has for it -->
        <DataTemplate x:Key="Page.items">
            <DockPanel DataContext="{Binding Editor}">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,14,8" MaxWidth="700" HorizontalAlignment="Left">
                    <DockPanel.Style>
                        <Style TargetType="DockPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsFocused}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                    </DockPanel.Style>
                    <Button DockPanel.Dock="Right" Command="{Binding ShowAllCommand}" Content="{DynamicResource LOCLS_ShowAllItems}" Padding="12,3" Margin="12,0,0,0" />
                    <TextBlock VerticalAlignment="Center" Foreground="#FFFFC56E"><Run Text="{DynamicResource LOCLS_ShowingOnly}" /><Run Text=" " /><Run Text="{Binding FocusedTitle, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                </DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,14,8">
                    <Button Command="{Binding ExpandAllCommand}" Content="{DynamicResource LOCLS_ExpandAll}" Padding="12,3" Margin="0,0,6,0" />
                    <Button Command="{Binding CollapseAllCommand}" Content="{DynamicResource LOCLS_CollapseAll}" Padding="12,3" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource LOCLS_ItemsHint}" TextWrapping="Wrap" Foreground="#FFA0A7B1" Margin="0,0,14,10" MaxWidth="700" HorizontalAlignment="Left" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,14,14" Padding="0,0,14,0">
                    <StackPanel>
                    <!-- Information shown once: items that show on several surfaces, which one keeps them, and the button that hides the other copies -->
                    <Border DataContext="{Binding Once}" Margin="0,0,0,10" Padding="14,8" CornerRadius="10" Background="#FF1D2128" BorderBrush="#33FFB347" BorderThickness="1" MaxWidth="760" HorizontalAlignment="Left">
                        <StackPanel Width="690">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding ShowAllCommand}" Content="{DynamicResource LOCLS_Once_ShowAll}" Padding="12,3" />
                                <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,8,0,0" Padding="0,6,0,0" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Command="{Binding ShowOnceCommand}" Content="{DynamicResource LOCLS_Once_ShowOnce}" Padding="12,3" Margin="8,0,0,0" />
                                                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Forced, Mode=TwoWay}" Content="{DynamicResource LOCLS_Once_Force}" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="{DynamicResource LOCLS_Once_ForceTip}" />
                                                    <ComboBox DockPanel.Dock="Right" Width="150" ItemsSource="{Binding KeepChoices}" DisplayMemberPath="Title" SelectedValuePath="Id" SelectedValue="{Binding Keep, Mode=TwoWay}" ToolTip="{DynamicResource LOCLS_Once_Keep}" />
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding WhereText}" FontSize="11" Foreground="#FFA0A7B1" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding BlockedText}" FontSize="11" Foreground="#FFFFC56E" TextWrapping="Wrap" Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasBlocked}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter"><Style.Triggers><DataTrigger Binding="{Binding Visible}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="14,6" CornerRadius="10" Background="#FF1D2128" BorderBrush="#14FFFFFF" BorderThickness="1" MaxWidth="760" HorizontalAlignment="Left">
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Foreground="#FFE8EAED">
                                        <Expander.Header>
                                            <DockPanel Width="640">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding OptionsText}" Opacity="0.55" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" />
                                                <TextBlock DockPanel.Dock="Right" Text="{DynamicResource LOCLS_TwiceBadge}" Foreground="#FFFFC56E" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ShowsTwice}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ChangedCount, StringFormat={}{0} changed}" Foreground="#FFFFB347" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasChanges}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Expander.Header>
                                        <StackPanel>
                                        <DockPanel Margin="0,4,0,2">
                                            <DockPanel.Style>
                                                <Style TargetType="DockPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ShowsTwice}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                                            </DockPanel.Style>
                                            <Button DockPanel.Dock="Right" Command="{Binding FoldSectionCommand}" Content="{Binding FoldText}" Padding="12,3" Margin="12,0,0,0" />
                                            <TextBlock Text="{Binding TwiceText}" TextWrapping="Wrap" Foreground="#FFFFC56E" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Surfaces}" Margin="4,0,0,8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="0,10,0,2" />
                                                        <ItemsControl ItemsSource="{Binding Settings}" ItemTemplateSelector="{StaticResource KindSelector}">
                                                            <ItemsControl.ItemContainerStyle>
                                                                <Style TargetType="ContentPresenter"><Style.Triggers><DataTrigger Binding="{Binding Visible}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style>
                                                            </ItemsControl.ItemContainerStyle>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </StackPanel>
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="Page.corners">
            <ScrollViewer DataContext="{Binding Editor}" VerticalScrollBarVisibility="Auto" Margin="0,0,14,14">
                <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource LOCLS_Corners_Look}" VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.7" />
                        <Button Command="{Binding SharpCommand}" Content="{DynamicResource LOCLS_Corners_Sharp}" Padding="14,4" Margin="0,0,6,0" ToolTip="{DynamicResource LOCLS_Corners_SharpTip}" />
                        <Button Command="{Binding SoftCommand}" Content="{DynamicResource LOCLS_Corners_Soft}" Padding="14,4" Margin="0,0,6,0" ToolTip="{DynamicResource LOCLS_Corners_SoftTip}" />
                        <Button Command="{Binding AppleCommand}" Content="{DynamicResource LOCLS_Corners_Designed}" Padding="14,4" Margin="0,0,6,0" ToolTip="{DynamicResource LOCLS_Corners_DesignedTip}" />
                        <Button Command="{Binding PillCommand}" Content="{DynamicResource LOCLS_Corners_Pill}" Padding="14,4" ToolTip="{DynamicResource LOCLS_Corners_PillTip}" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource LOCLS_Corners_Hint}" TextWrapping="Wrap" Foreground="#FFA0A7B1" Margin="0,0,0,12" />
                    <Border Padding="16,14" CornerRadius="10" Background="#FF1D2128" BorderBrush="#14FFFFFF" BorderThickness="1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{DynamicResource LOCLS_Corners_All}" FontSize="14" FontWeight="SemiBold" Width="150" VerticalAlignment="Center" />
                            <TextBox DockPanel.Dock="Right" Width="56" Text="{Binding Master, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Margin="10,0,0,0" />
                            <Slider Minimum="0" Maximum="150" LargeChange="10" SmallChange="1" Value="{Binding Master, Mode=TwoWay}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Items}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,10" Margin="0,0,0,8" CornerRadius="10" Background="#FF1D2128" BorderBrush="#14FFFFFF" BorderThickness="1">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="64" Height="40" Margin="0,0,14,0" Background="#26FFFFFF" BorderBrush="#99FFFFFF" BorderThickness="1.5" CornerRadius="{Binding Shape}" />
                                        <Button DockPanel.Dock="Right" Command="{Binding ResetCommand}" Content="Reset" Padding="8,1" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        <TextBox DockPanel.Dock="Right" Width="48" Text="{Binding Radius, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Margin="10,0,0,0" />
                                        <StackPanel Width="180" DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{DynamicResource LOCLS_Corners_Differ}" FontSize="10.5" Foreground="#FF8A93A0" Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <Slider Minimum="0" Maximum="60" LargeChange="5" SmallChange="1" Value="{Binding SliderRadius, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="Page.rules">
            <ScrollViewer DataContext="{Binding Editor}" VerticalScrollBarVisibility="Auto" Margin="0,0,14,14">
                <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                    <TextBlock Text="When the median FPS and the CPU, GPU and RAM figures turn red, orange, green or blue, and which colours those are. Changes show in the theme at once." TextWrapping="Wrap" Foreground="#FFA0A7B1" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,10" Margin="0,0,0,8" CornerRadius="10" Background="#FF1D2128" BorderBrush="#14FFFFFF" BorderThickness="1">
                                    <DockPanel>
                                        <TextBox DockPanel.Dock="Right" Width="56" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Margin="10,0,0,0" />
                                        <StackPanel Width="210" DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Group}" FontSize="10.5" Foreground="#FF8A93A0" />
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Hint}" FontSize="10.5" Foreground="#FF8A93A0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Slider Minimum="{Binding Min}" Maximum="{Binding Max}" LargeChange="5" SmallChange="1" Value="{Binding SliderValue, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Colours" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,6" />
                    <ItemsControl ItemsSource="{Binding Colors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,8" Margin="0,0,0,8" CornerRadius="10" Background="#FF1D2128" BorderBrush="#14FFFFFF" BorderThickness="1">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="6" BorderBrush="#66FFFFFF" BorderThickness="1" Margin="0,0,12,0" Background="{Binding Swatch}" />
                                        <TextBox DockPanel.Dock="Right" Width="96" Text="{Binding Hex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Command="{Binding ResetCommand}" Content="Reset to defaults" HorizontalAlignment="Left" Padding="12,4" Margin="0,6,0,0" />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="Page.background">
            <ScrollViewer DataContext="{Binding Editor}" VerticalScrollBarVisibility="Auto" Margin="0,0,14,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource LOCLS_BackgroundHint}" TextWrapping="Wrap" Opacity="0.65" Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource LOCLS_Preview}" Style="{StaticResource SectionTitle}" Margin="0,8,0,6" />
                    <!-- The real window, drawn by Playnite itself: same artwork, same glass layers, same panels. It follows the sliders a moment after you move them. -->
                    <Border HorizontalAlignment="Left" CornerRadius="8" ClipToBounds="True" Background="#FF0A0B0D" Margin="0,0,0,14" MaxWidth="640">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLivePreview}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Image Source="{Binding LivePreview}" Stretch="Uniform" />
                    </Border>
                    <Border Width="400" Height="250" HorizontalAlignment="Left" CornerRadius="8" ClipToBounds="True" Background="#FF1A1E26" Margin="0,0,0,14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLivePreview}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid ClipToBounds="True">
                            <Grid ClipToBounds="True">
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFE8883A" Offset="0" />
                                            <GradientStop Color="#FF3550C8" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Image Source="{Binding PreviewImagePath, Converter={StaticResource PathToImage}}" Stretch="UniformToFill">
                                    <Image.Effect>
                                        <BlurEffect Radius="{Binding PreviewBlurRadius}" KernelType="Gaussian" RenderingBias="Performance" />
                                    </Image.Effect>
                                </Image>
                                <Border Background="Black" Opacity="{Binding PreviewScrimOpacity}" />
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PreviewEnabled}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                            </Grid>
                            <Border HorizontalAlignment="Left" Width="84" Background="#FF14171C" Opacity="{Binding PreviewSidebarOpacity}" />
                            <Border HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="30" Background="#FF14171C" Opacity="{Binding PreviewTopOpacity}" />
                        </Grid>
                    </Border>
                    <TextBlock Text="WHERE THE ARTWORK SHOWS" FontSize="10.5" FontWeight="SemiBold" Foreground="#FF8A93A0" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Command="{Binding SetWindowCommand}" Content="Whole window" Padding="14,5" Margin="0,0,6,0">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsModeWindow}" Value="True"><Setter Property="Background" Value="#55FFB347" /><Setter Property="Foreground" Value="#FFFFC56E" /></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                        <Button Command="{Binding SetPageCommand}" Content="Game page only" Padding="14,5" Margin="0,0,6,0">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsModePage}" Value="True"><Setter Property="Background" Value="#55FFB347" /><Setter Property="Foreground" Value="#FFFFC56E" /></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                        <Button Command="{Binding SetOffCommand}" Content="Nowhere" Padding="14,5">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsModeOff}" Value="True"><Setter Property="Background" Value="#55FFB347" /><Setter Property="Foreground" Value="#FFFFC56E" /></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Sliders}" ItemTemplateSelector="{StaticResource KindSelector}" />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="Page.tiles">
            <ScrollViewer DataContext="{Binding Editor}" VerticalScrollBarVisibility="Auto" Margin="0,0,14,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource LOCLS_TilesHint}" TextWrapping="Wrap" Opacity="0.65" Margin="0,0,0,6" />
                    <TextBlock Text="Each cell shows up to four cards side by side. Pick the first card; a second list appears next to it, then a third and a fourth (for example FPS, RAM, CPU, GPU in one cell). Choose Empty to remove a card and the ones after it." TextWrapping="Wrap" Opacity="0.65" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource LOCLS_Slots}" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding Slots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="12,8" CornerRadius="10" Background="#2AFFFFFF" Cursor="Hand"
                                        ls:DragDropBehavior.DragKind="slot" ls:DragDropBehavior.DropSlot="True">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Number, StringFormat=Cell {0}}" FontWeight="SemiBold" Width="64" VerticalAlignment="Center" />
                                        <ItemsControl ItemsSource="{Binding Cards}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ComboBox Width="148" Margin="0,0,8,2" ItemsSource="{Binding Palette}" ItemTemplate="{StaticResource ChoiceWithPreview}" SelectedItem="{Binding Selected, Mode=TwoWay}">
                                                        <ComboBox.Style>
                                                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsVisible}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ComboBox.Style>
                                                    </ComboBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{DynamicResource LOCLS_Palette}" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding Palette}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,8,8" Padding="12,6" CornerRadius="15" Background="#33FFFFFF" Cursor="Hand" ls:DragDropBehavior.DragKind="tile">
                                    <TextBlock Text="{Binding Name}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- every information chip of the artwork card as one row: shown, and new line before -->
                    <TextBlock Text="{DynamicResource LOCLS_Header_Chips}" Style="{StaticResource SectionTitle}" Margin="0,22,0,6" />
                    <TextBlock Text="{DynamicResource LOCLS_Header_ChipsHint}" TextWrapping="Wrap" Opacity="0.65" Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,4" MaxWidth="640" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="{DynamicResource LOCLS_Header_ColShow}" Opacity="0.6" FontSize="11" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{DynamicResource LOCLS_Header_ColBreak}" Opacity="0.6" FontSize="11" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Extras.Chips}" MaxWidth="640" HorizontalAlignment="Left">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,5" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Show.BoolValue, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Breaks}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}" Margin="0,0,14,0" ToolTip="{Binding Title}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- the rest of the header parameters (artwork card, look, buttons, header bar, tile look...), the same settings as the Game header page -->
                    <TextBlock Text="{DynamicResource LOCLS_Header_All}" Style="{StaticResource SectionTitle}" Margin="0,26,0,0" />
                    <ItemsControl ItemsSource="{Binding Extras.Groups}" ItemTemplate="{DynamicResource GroupTemplate}" />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="Swatch.template">
            <Button Command="{Binding SelectCommand}" Width="132" Margin="0,0,10,10" Padding="0" ToolTip="{Binding Name}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Border Height="66" CornerRadius="8" BorderThickness="2" Padding="8,6">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{Binding Background1}" Offset="0" />
                            <GradientStop Color="{Binding Background2}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Ellipse DockPanel.Dock="Right" Width="18" Height="18" Fill="{Binding Accent, Converter={StaticResource ColorBrush}}" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding Name}" Foreground="{Binding Text, Converter={StaticResource ColorBrush}}" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="Page.colors">
            <ScrollViewer DataContext="{Binding Editor}" VerticalScrollBarVisibility="Auto" Margin="0,0,14,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource LOCLS_ColorsHint}" TextWrapping="Wrap" Opacity="0.65" Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource LOCLS_ColorProfiles}" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding Profiles}" ItemTemplate="{StaticResource Swatch.template}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="{DynamicResource LOCLS_Accents}" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding Accents}" ItemTemplate="{StaticResource Swatch.template}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="{DynamicResource LOCLS_CustomAccent}" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="AccentPickerToggle" Width="34" Height="30" Padding="3" Margin="0,0,10,0" IsChecked="{Binding PickerOpen, Mode=TwoWay}" ToolTip="{DynamicResource LOCLS_Color_Pick}">
                            <Border CornerRadius="5" BorderBrush="#66FFFFFF" BorderThickness="1" Background="{Binding CustomAccent, Converter={StaticResource ColorBrush}}" Width="24" Height="20" />
                        </ToggleButton>
                        <Popup IsOpen="{Binding PickerOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=AccentPickerToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="#FF1D2128" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4,0,8">
                                <StackPanel Width="236">
                                    <WrapPanel Margin="0,0,0,8"><Button Width="22" Height="22" Margin="2" Padding="0" Command="{Binding SetAccentCommand}" CommandParameter="#FFFFFF" ToolTip="#FFFFFF"><Border Width="16" Height="16" CornerRadius="3" Background="#FFFFFF" /></Button> <Button Width="22" Height="22" Margin="2" Padding="0" Command="{Binding SetAccentCommand}" CommandParameter="#9AA3AE" ToolTip="#9AA3AE"><Border Width="16" Height="16" CornerRadius="3" Background="#9AA3AE" /></Button> <Button Width="22" Height="22" Margin="2" Padding="0" Command="{Binding SetAccentCommand}" CommandParameter="#FF5252" ToolTip="#FF5252"><Border Width="16" Height="16" CornerRadius="3" Background="#FF5252" /></Button> <Button Width="22" Height="22" Margin="2" Padding="0" Command="{Binding SetAccentCommand}" CommandParameter="#FF9800" ToolTip="#FF9800"><Border Width="16" Height="16" CornerRadius="3" Background="#FF9800" /></Button> <Button Width="22" Height="22" Margin="2" Padding="0" Command="{Binding SetAccentCommand}" CommandParameter="#FFD54F" ToolTip="#FFD54F"><Border Width="16" Height="16" CornerRadius="3" Background="#FFD54F" /></Button> <Button Width="22" Height="22" Margin="2" Padding="0" Command="{Binding SetAccentCommand}" CommandParameter="#4CAF50" ToolTip="#4CAF50"><Border Width="16" Height="16" CornerRadius="3" Background="#4CAF50" /></Button> <Button Width="22" Height="22" Margin="2" Padding="0" Command="{Binding SetAccentCommand}" CommandParameter="#26C6DA" ToolTip="#26C6DA"><Border Width="16" Height="16" CornerRadius="3" Background="#26C6DA" /></Button> <Button Width="22" Height="22" Margin="2" Padding="0" Command="{Binding SetAccentCommand}" CommandParameter="#1E90FF" ToolTip="#1E90FF"><Border Width="16" Height="16" CornerRadius="3" Background="#1E90FF" /></Button> <Button Width="22" Height="22" Margin="2" Padding="0" Command="{Binding SetAccentCommand}" CommandParameter="#7C4DFF" ToolTip="#7C4DFF"><Border Width="16" Height="16" CornerRadius="3" Background="#7C4DFF" /></Button> <Button Width="22" Height="22" Margin="2" Padding="0" Command="{Binding SetAccentCommand}" CommandParameter="#E040FB" ToolTip="#E040FB"><Border Width="16" Height="16" CornerRadius="3" Background="#E040FB" /></Button> <Button Width="22" Height="22" Margin="2" Padding="0" Command="{Binding SetAccentCommand}" CommandParameter="#FF4081" ToolTip="#FF4081"><Border Width="16" Height="16" CornerRadius="3" Background="#FF4081" /></Button> <Button Width="22" Height="22" Margin="2" Padding="0" Command="{Binding SetAccentCommand}" CommandParameter="#1A9FFF" ToolTip="#1A9FFF"><Border Width="16" Height="16" CornerRadius="3" Background="#1A9FFF" /></Button></WrapPanel>
                                    <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Left" Text="R" Width="16" Foreground="#FFFF7B72" /><TextBlock DockPanel.Dock="Right" Text="{Binding AccentR, StringFormat={}{0:0}}" Width="30" TextAlignment="Right" /><Slider Minimum="0" Maximum="255" SmallChange="1" LargeChange="16" Value="{Binding AccentR, Mode=TwoWay}" /></DockPanel>
                                    <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Left" Text="G" Width="16" Foreground="#FF6FD08C" /><TextBlock DockPanel.Dock="Right" Text="{Binding AccentG, StringFormat={}{0:0}}" Width="30" TextAlignment="Right" /><Slider Minimum="0" Maximum="255" SmallChange="1" LargeChange="16" Value="{Binding AccentG, Mode=TwoWay}" /></DockPanel>
                                    <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Left" Text="B" Width="16" Foreground="#FF8AB4F8" /><TextBlock DockPanel.Dock="Right" Text="{Binding AccentB, StringFormat={}{0:0}}" Width="30" TextAlignment="Right" /><Slider Minimum="0" Maximum="255" SmallChange="1" LargeChange="16" Value="{Binding AccentB, Mode=TwoWay}" /></DockPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <TextBox Width="150" Text="{Binding CustomAccent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="0,4,0,0" />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- Diagnostics: what Layout Studio sees, to read or to copy into a bug report -->
        <DataTemplate x:Key="Page.diagnostics">
            <ScrollViewer DataContext="{Binding Editor}" VerticalScrollBarVisibility="Auto" Margin="0,0,14,14">
                <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="{DynamicResource LOCLS_DiagnosticsHint}" TextWrapping="Wrap" Foreground="#FFA0A7B1" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Command="{Binding RefreshCommand}" Content="{DynamicResource LOCLS_Refresh}" Padding="14,5" Margin="0,0,8,0" />
                        <Button Command="{Binding CopyCommand}" Content="{DynamicResource LOCLS_CopyDiagnostics}" Padding="14,5" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Opacity="0.7" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,8" Margin="0,0,0,6" CornerRadius="8" Background="#FF1D2128" BorderBrush="#14FFFFFF" BorderThickness="1">
                                    <DockPanel>
                                        <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,5,12,0" VerticalAlignment="Top">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#FF6B7480" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOk}" Value="True"><Setter Property="Fill" Value="#FF4FC82F" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsWarning}" Value="True"><Setter Property="Fill" Value="#FFFFB347" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" TextWrapping="Wrap" MaxWidth="360" Margin="12,0,0,0" TextAlignment="Right" />
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="11" Foreground="#FF8A93A0" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasDetail}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="Page.share">
            <ScrollViewer DataContext="{Binding Editor}" VerticalScrollBarVisibility="Auto" Margin="0,0,14,14">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                    <!-- profiles: switch between saved looks, or start a new one from the current -->
                    <StackPanel>
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasSwitcher}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock Text="{DynamicResource LOCLS_Profiles}" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding SwitchCommand}" Content="{Binding Name}" Padding="14,5" Margin="0,0,6,6">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Background" Value="#55FFB347" /><Setter Property="Foreground" Value="#FFFFC56E" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="0,4,0,18" Width="420" HorizontalAlignment="Left">
                            <Button DockPanel.Dock="Right" Command="{Binding NewProfileCommand}" Content="{DynamicResource LOCLS_NewProfile}" Padding="14,5" Margin="8,0,0,0" />
                            <TextBox Text="{Binding NewProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource LOCLS_ShareHint}" TextWrapping="Wrap" Opacity="0.65" Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource LOCLS_ShareCode}" Style="{StaticResource SectionTitle}" />
                    <TextBox Text="{Binding Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="110" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Command="{Binding ExportCommand}" Content="{DynamicResource LOCLS_Export}" Padding="14,5" Margin="0,0,8,0" />
                        <Button Command="{Binding ImportCommand}" Content="{DynamicResource LOCLS_Import}" Padding="14,5" />
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.85">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="#FFFF7B72" />
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{DynamicResource LOCLS_ResetAllTitle}" Style="{StaticResource SectionTitle}" Margin="0,22,0,6" />
                    <TextBlock Text="{DynamicResource LOCLS_ResetAllHint}" TextWrapping="Wrap" Opacity="0.65" Margin="0,0,0,8" />
                    <Button Command="{Binding AskResetCommand}" Content="{DynamicResource LOCLS_ResetAll}" Padding="14,5" HorizontalAlignment="Left">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResetPending}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResetPending}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Command="{Binding ConfirmResetCommand}" Content="{DynamicResource LOCLS_ResetConfirm}" Padding="14,5" Margin="0,0,8,0" />
                        <Button Command="{Binding CancelResetCommand}" Content="{DynamicResource LOCLS_Cancel}" Padding="14,5" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="GroupTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                <ItemsControl ItemsSource="{Binding Settings}" ItemTemplateSelector="{StaticResource KindSelector}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Visible}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar: search, undo/redo, reset page -->
        <Grid Margin="14,12,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,14,0">
                <TextBox x:Name="SearchBox" Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center" Padding="4,0,28,0"
                         ToolTip="{DynamicResource LOCLS_Search}" />
                <TextBlock Text="{DynamicResource LOCLS_SearchPlaceholder}" IsHitTestVisible="False" Foreground="#FF8A93A0" Margin="9,0,0,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Command="{Binding ClearSearchCommand}" Content="&#xE894;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Right" Width="26" Height="24" Margin="0,0,3,0" Padding="0" ToolTip="{DynamicResource LOCLS_ClearSearch}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style>
                    </Button.Style>
                </Button>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasModes}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                    </StackPanel.Style>
                    <Button Command="{Binding ShowDesktopCommand}" Content="{DynamicResource LOCLS_Mode_Desktop}" Padding="12,4" Margin="0,0,2,0">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsDesktopMode}" Value="True"><Setter Property="Background" Value="#55FFB347" /><Setter Property="Foreground" Value="#FFFFC56E" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                    <Button Command="{Binding ShowFullscreenCommand}" Content="{DynamicResource LOCLS_Mode_Fullscreen}" Padding="12,4" ToolTip="{DynamicResource LOCLS_Mode_FullscreenTip}">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsFullscreenMode}" Value="True"><Setter Property="Background" Value="#55FFB347" /><Setter Property="Foreground" Value="#FFFFC56E" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                </StackPanel>
                <Button Command="{Binding UndoCommand}" Content="{Binding UndoLabel}" ToolTip="Ctrl+Z" MaxWidth="260" Padding="12,4" Margin="0,0,6,0" />
                <Button Command="{Binding RedoCommand}" Content="{Binding RedoLabel}" ToolTip="Ctrl+Y" MaxWidth="260" Padding="12,4" Margin="0,0,14,0" />
                <ToggleButton IsChecked="{Binding ShowChangedOnly, Mode=TwoWay}" Padding="12,4" Margin="0,0,14,0" ToolTip="{DynamicResource LOCLS_ChangedTip}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource LOCLS_Changed}" /><TextBlock Text="{Binding ChangedTotal}" Foreground="#FFFFB347" Margin="6,0,0,0" FontWeight="SemiBold" /></StackPanel>
                </ToggleButton>
                <Button Command="{Binding ResetPageCommand}" Content="{Binding ResetPageLabel}" Padding="12,4"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding ResetPending}" Value="True"><Setter Property="Background" Value="#FFB5651D" /><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1">
        <Border Margin="14,0,14,10" Padding="12,8" CornerRadius="6" Background="#33FF7B72">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ProfileWarning}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ProfileWarning}" TextWrapping="Wrap" />
        </Border>
        <Border Margin="14,0,14,10" Padding="12,8" CornerRadius="6" Background="#22FFB347" DataContext="{Binding PlayniteSettings}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions><Condition Binding="{Binding HasFindings}" Value="False" /><Condition Binding="{Binding HasStatus}" Value="False" /></MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding HasFindings}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        <DataTrigger Binding="{Binding HasStatus}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Findings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Command="{Binding FixCommand}" Content="{DynamicResource LOCLS_Banner_Fix}" Padding="12,3" Margin="12,0,0,0" VerticalAlignment="Top" />
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding FixAllCommand}" Content="{DynamicResource LOCLS_Banner_FixAll}" Padding="12,3" Margin="0,0,8,0" />
                    <Button Command="{Binding RestoreCommand}" Content="{DynamicResource LOCLS_Banner_PutBack}" Padding="12,3" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Margin="14,0,14,10" Padding="12,8" CornerRadius="6" Background="#2A8AB4F8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding HasSensorProblems}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="HWiNFO gadget and GameActivity do not match: the FPS, CPU, GPU and RAM numbers it logs may be wrong. In HWiNFO, tick 'Report value in Gadget' for the right sensors in the order GameActivity expects, or change the positions in GameActivity's settings." TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding SensorProblems}">
                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,3" /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <Border Margin="14,0,14,10" Padding="12,8" CornerRadius="6" Background="#33FFB347">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RestartRequired}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{DynamicResource LOCLS_NeedsRestart}" TextWrapping="Wrap" />
        </Border>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox ItemsSource="{Binding PagesView}" SelectedItem="{Binding SelectedPage, Mode=TwoWay}" Margin="14,0,8,14"
                     BorderThickness="0" Background="Transparent">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" Foreground="#FF8A93A0" Margin="6,12,0,2" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="4,6" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ChangedCount}" Foreground="#FFFFB347" FontWeight="SemiBold" Margin="8,0,0,0" ToolTip="Settings changed on this page">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding HasChanges}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding MatchCount}" Opacity="0.5" Margin="8,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowCount}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Dimmed}" Value="True"><Setter Property="Opacity" Value="0.35" /></DataTrigger></Style.Triggers></Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ContentControl Grid.Column="1" Content="{Binding SelectedPage}" ContentTemplateSelector="{StaticResource PageSelector}" />
        </Grid>
    </Grid>
</Window>
